{
  "name": "bowebsite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --env-file=.env --watch server/index.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node --env-file=.env server/index.js"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.1"
  }
}
